# Exactly one upstream. Point this at NGINX/HAProxy/Caddy when you need routing,
# authentication, TLS to another host, or several backend applications.
VHTTP_UPSTREAM_URL=http://host.docker.internal:8080
VHTTP_IMAGE_TAG=dev
VHTTP_LOG_LEVEL=info

# Hostile-network defaults. Individual HTTP AbortSignals still cancel requests early.
VHTTP_IDLE_TIMEOUT=5m
VHTTP_OVERALL_TIMEOUT=60m
VHTTP_REMOTE_TIMEOUT=2m
VHTTP_FRAME_BYTES=30720
VHTTP_SEND_WINDOW_FRAMES=32

# Per-transaction bounded buffering. Complete files are never accumulated here.
VHTTP_MAX_PENDING_BYTES=8388608
VHTTP_MAX_OUT_OF_ORDER_BYTES=4194304
VHTTP_MAX_REQUEST_BYTES=0
VHTTP_MAX_RESPONSE_BYTES=0
VHTTP_MAX_ATOMIC_BODY_BYTES=8388608

# At-most-once forwarding retention. Small atomic replies can be replayed; large and
# streamed replies leave a durable tombstone so a duplicate POST is not re-executed.
VHTTP_COMPLETED_RETENTION=15m
VHTTP_COMPLETED_RESPONSE_BYTES=1048576
VHTTP_COMPLETED_MAX_ENTRIES=4096

VHTTP_FORWARD_ROUTE_HEADER=X-Veilid-Route-Fingerprint
VHTTP_ADAPTER_MODE=remote

# Bound inside the one container and never published to the Docker host.
VEILID_CLIENT_ENDPOINT=127.0.0.1:5959
VEILID_EXPECTED_VERSION_PREFIX=0.5.5

# Veilid packages are selected only when the image is built. Running containers
# are immutable and receive updates through a new tested image rollout.
VEILID_RELEASE_CHANNEL=stable
VEILID_VERSION=0.5.5
