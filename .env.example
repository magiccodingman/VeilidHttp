# Exactly one upstream. Point this at NGINX/HAProxy/Caddy when you need routing,
# authentication, TLS to another host, or several backend applications.
VHTTP_UPSTREAM_URL=http://host.docker.internal:8080
VHTTP_IMAGE_TAG=dev
VHTTP_LOG_LEVEL=info
VHTTP_IDLE_TIMEOUT=5m
VHTTP_OVERALL_TIMEOUT=60m
VHTTP_FRAME_BYTES=30720
VHTTP_SEND_WINDOW_FRAMES=32
VHTTP_FORWARD_ROUTE_HEADER=X-Veilid-Route-Fingerprint

# `remote` is the intended live adapter. Development currently uses the explicit
# `validation` supervisor until the veilid-server remote adapter is completed.
VHTTP_ADAPTER_MODE=remote

# Convenience-first default: only veilid-server/veilid-cli are updated on start.
# Set false for immutable operation, or pin an exact package version.
VEILID_AUTO_UPDATE=true
VEILID_RELEASE_CHANNEL=stable
VEILID_VERSION=latest
